APP_NAME=Grocerly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mini_ecom_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Leave unset locally (plain HTTP); MUST be true in every deployed environment.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Never commit a real value here. Set it in the deployment environment only.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# --- API -------------------------------------------------------------------

# Comma-separated allowlist of browser origins permitted to call the API. There
# is no wildcard fallback: an origin that is not listed is refused.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where password-reset / email-verification links send the customer.
API_FRONTEND_URL=http://localhost:3000

# Token lifetimes, in seconds.
API_ACCESS_TOKEN_TTL=900
API_REFRESH_TOKEN_TTL=2592000

# Requests per minute, per limiter scope.
API_RATE_LIMIT_AUTH=5
API_RATE_LIMIT_LOGIN_EMAIL=10
API_RATE_LIMIT_REFRESH=10
API_RATE_LIMIT_VERIFICATION=5
API_RATE_LIMIT_AUTHENTICATED=120
API_RATE_LIMIT_CATALOG=60
API_RATE_LIMIT_WEBHOOK=60
API_RATE_LIMIT_CHECKOUT=20
API_RATE_LIMIT_PAYMENT=12

# Failed email-verification code attempts before the code is burned.
API_VERIFICATION_MAX_ATTEMPTS=5

# Public catalogue response cache, in seconds. 0 disables caching entirely.
API_CATALOG_CACHE_TTL=60

# Comma-separated proxy IPs/CIDRs, or "*" when behind a trusted platform load
# balancer (Vercel, Cloudflare, ALB). Required for correct per-IP throttling.
API_TRUSTED_PROXIES=

# --- Bakong KHQR payment ----------------------------------------------------
# Keep BAKONG_ENABLED=false until every merchant field and the provider-issued token
# are configured in the deployment environment. Never commit a real token.
BAKONG_ENABLED=false
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_CHECK_TRANSACTION_PATH=/v1/check_transaction_by_md5
BAKONG_API_TOKEN=

# `individual` uses account/name/city. `merchant` additionally requires the merchant ID
# and acquiring bank exactly as issued for the Bakong merchant profile.
BAKONG_PROFILE_TYPE=individual
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_MOBILE_NUMBER=
BAKONG_CURRENCY=USD
BAKONG_PAYMENT_TTL_MINUTES=20
BAKONG_CONNECT_TIMEOUT_SECONDS=5
BAKONG_TIMEOUT_SECONDS=10
